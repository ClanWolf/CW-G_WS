<h1>{{pageTitle}}</h1>
<h2>API documentation</h2>
<a target="_blank" href="/api/docs">Swagger documentation (auto generated)</a>
<h2>Logs</h2>
<ul>
	{{#each logFiles}}
	<li><a href="{{../logPath}}{{name}}" target="log">{{name}}</a> (Log written by the service)</li>
	{{/each}}
	<li><a href="{{logPath}}consolelog.txt" target="log">Server passenger log</a> (Nodejs context)</li>
</ul>
<h2>C3-Server Logs</h2>

<iframe id="log" name="log" title="Log window" style="position:fixed;width:100%;height:100%;border:1px solid #000;" src="{{logPath}}consolelog.txt"></iframe>

<script type="text/javascript">
	function adjustIframe() {
		var h = document.getElementById('log').contentWindow.document.body.scrollHeight;
		console.log(h);
		document.getElementById('log').height = h;
	}

	adjustIframe();
	window.onload = adjustIframe;
	window.onresize = adjustIframe;
</script>
